    "blocks": {
        "pcfw/compare-bar": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "pcfw/compare-bar",
            "title": "Compare Bar",
            "category": "woocommerce",
            "icon": "align-wide",
            "description": "Shows the sticky compare bar on this page, even when the bar is off in the settings.",
            "keywords": [
                "compare",
                "bar",
                "sticky"
            ],
            "textdomain": "product-comparison-for-woocommerce",
            "attributes": {
                "position": {
                    "type": "string",
                    "enum": [
                        "",
                        "bottom",
                        "top"
                    ],
                    "default": ""
                },
                "showSearch": {
                    "type": "boolean",
                    "default": true
                }
            },
            "supports": {
                "html": false,
                "multiple": false,
                "inserter": true
            },
            "editorScript": "pcfw-blocks-editor",
            "render": "file:./render.php"
        },
        "pcfw/compare-table": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "pcfw/compare-table",
            "title": "Compare Table",
            "category": "woocommerce",
            "icon": "editor-table",
            "description": "The comparison table: the shopper's own list, or fixed products you choose.",
            "keywords": [
                "compare",
                "comparison",
                "table"
            ],
            "textdomain": "product-comparison-for-woocommerce",
            "attributes": {
                "productIds": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    },
                    "default": []
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": []
                },
                "onlyDiffToggle": {
                    "type": "boolean",
                    "default": true
                },
                "layout": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "table",
                        "cards"
                    ],
                    "default": "auto"
                }
            },
            "supports": {
                "html": false,
                "align": [
                    "wide",
                    "full"
                ]
            },
            "editorScript": "pcfw-blocks-editor",
            "render": "file:./render.php"
        },
        "pcfw/compare-button": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "pcfw/compare-button",
            "title": "Compare Button",
            "category": "woocommerce",
            "icon": "columns",
            "description": "Adds the current product to the comparison. Works inside Product Collection and Single Product templates.",
            "keywords": [
                "compare",
                "comparison",
                "product"
            ],
            "textdomain": "product-comparison-for-woocommerce",
            "usesContext": [
                "postId",
                "postType"
            ],
            "attributes": {
                "productId": {
                    "type": "number",
                    "default": 0
                },
                "style": {
                    "type": "string",
                    "enum": [
                        "",
                        "button",
                        "link",
                        "icon",
                        "checkbox"
                    ],
                    "default": ""
                },
                "label": {
                    "type": "string",
                    "default": ""
                },
                "showIcon": {
                    "type": "boolean",
                    "default": true
                }
            },
            "supports": {
                "html": false,
                "align": false,
                "spacing": {
                    "margin": true
                }
            },
            "editorScript": "pcfw-blocks-editor",
            "editorStyle": "pcfw-storefront",
            "render": "file:./render.php"
        },
        "pcfw/compare-counter": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "pcfw/compare-counter",
            "title": "Compare Counter",
            "category": "woocommerce",
            "icon": "columns",
