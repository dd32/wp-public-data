            "supports": {
                "html": false,
                "spacing": {
                    "margin": true,
                    "padding": true
                },
                "typography": {
                    "fontSize": true
                }
            },
            "editorScript": "pcfw-blocks-editor",
            "editorStyle": "pcfw-storefront",
            "render": "file:./render.php"
        }
