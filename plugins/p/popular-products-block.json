                    "default": true
                },
                "isTitle": {
                    "type": "boolean",
                    "default": true
                },
                "isRating": {
                    "type": "boolean",
                    "default": false
                },
                "isPrice": {
                    "type": "boolean",
                    "default": true
                },
                "isAddToCartBtn": {
                    "type": "boolean",
                    "default": true
                },
                "textAlign": {
