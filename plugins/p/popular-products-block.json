                    "type": "string",
                    "default": ""
                },
                "productsPerPage": {
                    "type": "number",
                    "default": 9
                },
                "stockStatus": {
                    "type": "array",
                    "default": [
                        "instock",
                        "outofstock",
                        "onbackorder"
                    ]
                },
                "selectedCategories": {
                    "type": "array",
                    "default": []
                },
