    "blocks": {
        "hotblocks/contact": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "hotblocks/contact",
            "title": "HotBlocks Contact Form",
            "category": "widgets",
            "icon": "email",
            "description": "Simple contact form with optional anti-spam question.",
            "textdomain": "hotblocks-contact-form",
            "supports": {
                "html": false,
                "spacing": {
                    "margin": true,
                    "padding": true
                },
                "color": {
                    "text": true,
                    "background": true
                }
            },
            "attributes": {
                "recipientEmail": {
                    "type": "string",
                    "default": ""
                },
                "labelMode": {
                    "type": "string",
                    "default": "labels"
                },
                "nameLabel": {
                    "type": "string",
                    "default": "Name"
                },
                "emailLabel": {
                    "type": "string",
                    "default": "Email"
                },
                "subjectLabel": {
                    "type": "string",
                    "default": "Subject"
                },
                "messageLabel": {
                    "type": "string",
                    "default": "Message"
                },
                "buttonText": {
                    "type": "string",
                    "default": "Submit"
                },
                "antiSpamQuestion": {
                    "type": "string",
                    "default": ""
                },
                "antiSpamAnswer": {
                    "type": "string",
                    "default": ""
                }
            },
            "editorScript": "file:./index.js",
            "editorStyle": "file:./index.css",
            "style": "file:./style-index.css",
            "render": "file:./render.php",
            "viewScript": "file:./view.js"
        }
    },
