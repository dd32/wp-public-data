    "blocks": {
        "kodionica/qr-code-generator": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "kodionica/qr-code-generator",
            "version": "1.0.0",
            "title": "QR Code Generator",
            "category": "widgets",
            "icon": "format-image",
            "description": "",
            "keywords": [
                "qr code",
                "qr",
                "generator"
            ],
            "attributes": {
                "value": {
                    "type": "string",
                    "default": ""
                },
                "size": {
                    "type": "integer",
                    "default": 200
                },
                "margin": {
                    "type": "integer",
                    "default": 0
                },
                "typeNumber": {
                    "type": "integer",
                    "default": 7
                },
                "errorCorrectionLevel": {
                    "enum": [
                        "L",
                        "M",
                        "Q",
                        "H"
                    ],
                    "default": "Q"
                },
                "bgColor": {
                    "type": "string",
                    "default": "#fff"
                }
            },
            "supports": {
                "html": false,
                "align": [
                    "left",
                    "center",
                    "right",
                    "wide",
                    "full"
                ],
                "alignWide": true
            },
            "example": [],
            "textdomain": "stefan-blocks",
            "viewScriptModule": "file:./view.js",
            "editorScript": "file:./index.js",
            "editorStyle": "file:./index.css",
            "style": "file:./style-index.css",
            "render": "file:./render.php"
        }
    },
