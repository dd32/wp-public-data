    "sections": {
        "description": "<p>Xpert Slider Kits for Elementor provides a collection of Elementor widgets for building responsive sliders, galleries, carousels, team sliders, app sliders, and blog sliders.</p>\n",
        "installation": "<ol>\n<li>Upload the <code>xpert-slider-kits-for-elementor</code> folder to <code>/wp-content/plugins/</code>.</li>\n<li>Activate Xpert Slider Kits from the Plugins screen.</li>\n<li>Edit a page with Elementor and use the Xpert Slider Kits widget category.</li>\n</ol>\n",
        "faq": "\n<dt id=\"does%20this%20plugin%20require%20elementor%3F\">\nDoes this plugin require Elementor?\n</h4>\n<p>\n<p>Yes. Elementor must be installed and active.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial XpertCodes release.</li>\n</ul>\n"
    },
