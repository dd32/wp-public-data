    "sections": {
        "description": "<p>Xpert Pricing Plan Switcher for Elementor adds a pricing plan switcher widget for building monthly and yearly pricing layouts in Elementor.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to /wp-content/plugins/</li>\n<li>Activate the plugin through Plugins in WordPress</li>\n<li>Make sure Elementor is installed and activated</li>\n<li>Edit any page with Elementor and add the Pricing Plan Switcher widget</li>\n</ol>\n",
        "faq": "\n<dt id=\"does%20this%20plugin%20require%20elementor%3F\">\nDoes this plugin require Elementor?\n</h4>\n<p>\n<p>Yes, Elementor must be installed and activated.</p>\n</p>\n<dt id=\"are%20frontend%20assets%20minified%3F\">\nAre frontend assets minified?\n</h4>\n<p>\n<p>No. The distributed CSS and JavaScript files are human-readable source files.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Refactored to XpertCodes standard</li>\n<li>Added settings toggle for frontend assets</li>\n<li>Removed minified bundled assets and Composer boilerplate</li>\n<li>Updated plugin header and folder structure</li>\n</ul>\n"
    },
