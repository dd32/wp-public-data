    "sections": {
        "description": "<p>This plugin adds an email notification to WooCommerce that is triggered when an order is cancelled. You can customize the message, recipient, and other settings.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to <code>/wp-content/plugins/</code></li>\n<li>Activate the plugin via the Plugins menu in WordPress.</li>\n<li>Go to WooCommerce &gt; Settings &gt; Emails and configure the new email notification.</li>\n</ol>\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
    "short_description": "Send a custom email notification to the customer whenever an order is cancelled in WooCommerce.",
