            "keywords": [
                "form"
            ],
            "textdomain": "contact-form-7",
            "attributes": {
                "id": {
                    "type": "integer"
                },
                "hash": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "htmlId": {
                    "type": "string"
                },
                "htmlName": {
                    "type": "string"
                },
                "htmlTitle": {
                    "type": "string"
                },
                "htmlClass": {
                    "type": "string"
                },
                "output": {
                    "enum": [
                        "form",
                        "raw_form"
                    ],
                    "default": "form"
                }
            },
            "editorScript": [
                "file:./index.js",
                "contact-form-7-block-editor"
            ]
        }
    },
