    "sections": {
        "description": "<p>ColorfulNode Slide Popup is a lightweight popup banner plugin for WordPress.</p>\n<p>Features:</p>\n<ul>\n<li>Bottom-right slide popup</li>\n<li>Lightweight and fast</li>\n<li>No frontend jQuery dependency</li>\n<li>Mobile friendly</li>\n<li>Close button support</li>\n<li>LocalStorage support</li>\n<li>WordPress Media Uploader support</li>\n</ul>\n",
        "installation": "<ol>\n<li>Upload the plugin files to the <code>/wp-content/plugins/colorfulnode-slide-popup</code> directory.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; screen in WordPress.</li>\n<li>Configure the plugin from the &#8216;ColorfulNode Popup&#8217; menu.</li>\n</ol>\n",
        "faq": "\n<dt id=\"does%20this%20plugin%20require%20jquery%3F\">\nDoes this plugin require jQuery?\n</h4>\n<p>\n<p>No. Frontend behavior works without jQuery.</p>\n</p>\n<dt id=\"is%20it%20mobile%20friendly%3F\">\nIs it mobile friendly?\n</h4>\n<p>\n<p>Yes.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
