    "sections": {
        "description": "<p>Conditional Widget Display lets you control widget visibility based on:</p>\n<ul>\n<li>Pages</li>\n<li>Posts</li>\n</ul>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to <code>/wp-content/plugins/</code></li>\n<li>Activate the plugin from your WordPress dashboard.</li>\n<li>Go to Appearance <span aria-hidden=\"true\" class=\"wp-exclude-emoji\">→</span> Widgets and configure visibility options under each widget.</li>\n<li>Adjust the condition according to your requirement.</li>\n</ol>\n",
        "faq": "\n<dt id='does%20it%20support%20custom%20post%20types%3F%20%3D%20yes.'>\nDoes it support custom post types? = Yes.\n</h4>\n<p></p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
    "short_description": "Show or hide widgets based on posts and page — no coding needed!",
