    "sections": {
        "description": "<p>Wheelluck is a simple plugin that engages your visitors with AI-powered spin-to-win experiences and optionally adds a JavaScript file from CDN.<br />\nUser consent is obtained during installation and the script is loaded to the site in a one-time process.<br />\nNo additional settings page is needed.</p>\n",
        "installation": "<ol>\n<li>Download the plugin.</li>\n<li>Upload it to the <code>wp-content/plugins/</code> directory or upload as zip through the WordPress admin panel.</li>\n<li>Activate it from the &#8220;Plugins&#8221; section in the WordPress admin panel.</li>\n<li>Click the &#8220;Enable&#8221; button from the notification box that appears in the admin panel during initial setup to load the CDN JavaScript.</li>\n<li>You can access the dashboard by clicking the &#8220;Wheelluck&#8221; submenu in the WordPress admin menu.</li>\n</ol>\n",
        "changelog": "<h4>1.0.2</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
    "short_description": "Adds a link to the WordPress admin menu and loads a JavaScript file from CDN with user consent during installation.",
