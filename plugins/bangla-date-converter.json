    "sections": {
        "description": "<p>This plugin automatically detects dates in your content and converts them into Bangla (বাংলা) format. Supports multiple formats, a settings toggle, and a shortcode to show today’s date in Bangla.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin files to <code>/wp-content/plugins/bangla-date-converter</code>.</li>\n<li>Activate through the WordPress admin.</li>\n<li>Go to Settings &gt; Bangla Date Converter to configure.</li>\n</ol>\n",
        "changelog": "<h4>1.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
    "short_description": "Converts English dates like 2025-01-20 into beautiful Bangla date formats. Simple, lightweight, and automatic.",
    "description": "<p>This plugin automatically detects dates in your content and converts them into Bangla (বাংলা) format. Supports multiple formats, a settings toggle, and a shortcode to show today’s date in Bangla.</p>\n",
