    "sections": {
        "description": "<p>DiscountPilot – Dynamic Pricing &amp; Discount Rules for WooCommerce allows you to create complex discount rules for your WooCommerce store. Supports bulk pricing, tiered pricing, bundle discounts, BOGO deals, and more.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin files to the <code>/wp-content/plugins/discountpilot-dynamic-pricing</code> directory, or install the plugin through the WordPress plugins screen directly.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; screen in WordPress.</li>\n<li>Use the Settings-&gt;DiscountPilot – Dynamic Pricing &amp; Discount Rules for WooCommerce screen to configure the plugin.</li>\n</ol>\n",
        "faq": "\n<dt id=\"how%20do%20i%20add%20a%20discount%3F\">\nHow do I add a discount?\n</h4>\n<p>\n<p>Go to DiscountPilot – Dynamic Pricing &amp; Discount Rules for WooCommerce settings and add a new discount rule.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
