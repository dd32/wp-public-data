        "fundy/donation-form": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "fundy/donation-form",
            "title": "Donation Form",
            "description": "Displays a donation form.",
            "category": "widgets",
            "textdomain": "fundy",
            "icon": "clipboard",
            "supports": {
