    "sections": {
        "description": "<p>TestFlow helps WordPress Test Team moderators facilitate weekly test chat and patch testing scrub sessions.</p>\n<h4>Supported session types</h4>\n<ul>\n<li><strong>Patch Testing Scrub</strong> — weekly 1-hour session where the moderator assigns tickets to contributors for patch testing</li>\n<li><strong>Test Chat</strong> — weekly 1-hour team chat covering agenda discussions, ecosystem announcements, and open floor</li>\n</ul>\n",
        "installation": "<ol>\n<li>Upload the plugin to <code>wp-content/plugins/testflow/</code>, or install it directly from the WordPress admin <strong>Plugins</strong> screen</li>\n<li>Activate the plugin from the WordPress admin <strong>Plugins</strong> screen</li>\n<li>Navigate to <strong>TestFlow</strong> in the admin sidebar</li>\n</ol>\n",
        "faq": "\n<dt id=\"who%20is%20this%20plugin%20for%3F\">\nWho is this plugin for?\n</h4>\n<p>\n<p>WordPress Test Team moderators who run Patch Testing Scrub and Test Chat sessions.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.1</h4>\n<ul>\n<li>Added TestFlow link to the admin bar.</li>\n</ul>\n<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
