    "sections": {
        "description": "<p>Frenglish provides a seamless way to translate your WordPress content into multiple languages. It integrates with your existing WordPress setup and provides an intuitive interface for managing translations.</p>\n<p>Key Features:</p>\n<ul>\n<li>Automatic language detection</li>\n<li>URL-based language switching</li>\n<li>Support for multiple languages</li>\n<li>Easy-to-use admin interface</li>\n<li>SEO-friendly URLs</li>\n<li>Compatible with most WordPress themes</li>\n</ul>\n<h3>Privacy Policy</h3>\n<p>Frenglish uses an external API service for translations. Visit frenglish.ai for additional information</p>\n",
        "installation": "<ol>\n<li>Upload the <code>frenglish</code> folder to the <code>/wp-content/plugins/</code> directory</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; menu in WordPress</li>\n<li>Create an account on Frenglish.ai</li>\n<li>Add a &#8220;Website&#8221; project on Frenglish.ai and configure your project settings</li>\n<li>Go to your Website Settings on Frenglish to retrieve your public API key</li>\n<li>On WordPress&#8217;s Frenglish Settings&#8217; page, add your public API key and click &#8220;save changes&#8221;</li>\n<li>You&#8217;re done! The next time you open your site, you&#8217;ll have translated content!</li>\n</ol>\n",
        "faq": "\n<dt id='how%20do%20i%20get%20an%20api%20key%3F'>\nHow do I get an API key?\n</h4>\n<p>\n<p>Visit www.frenglish.ai to create an account and obtain your API key.</p>\n</p>\n<dt id='which%20languages%20are%20supported%3F'>\nWhich languages are supported?\n</h4>\n<p>\n<p>Frenglish supports multiple languages including English, French, Spanish, German, and more (over 100).</p>\n</p>\n<dt id='is%20it%20compatible%20with%20my%20theme%3F'>\nIs it compatible with my theme?\n</h4>\n<p>\n<p>Yes, Frenglish is designed to work with any WordPress theme.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
    "short_description": "Frenglish is a translation plugin that enables multilingual content on your WordPress site with an easy-to-use interface.",
    "description": "<p>Frenglish provides a seamless way to translate your WordPress content into multiple languages. It integrates with your existing WordPress setup and provides an intuitive interface for managing translations.</p>\n<p>Key Features:</p>\n<ul>\n<li>Automatic language detection</li>\n<li>URL-based language switching</li>\n<li>Support for multiple languages</li>\n<li>Easy-to-use admin interface</li>\n<li>SEO-friendly URLs</li>\n<li>Compatible with most WordPress themes</li>\n</ul>\n<h3>Privacy Policy</h3>\n<p>Frenglish uses an external API service for translations. Visit frenglish.ai for additional information</p>\n",
    "download_link": "https://downloads.wordpress.org/plugin/frenglish-translations.1.1.24.zip",
    "upgrade_notice": {
        "1.0.1": "<ul>\n<li>Tested 6.8 Wordpress update and updated README.txt</li>\n</ul>",
        "1.1.0": "<ul>\n<li>Offer server-side translations for SEO</li>\n</ul>",
        "1.1.2": "<ul>\n<li>Reflush and re-write rules on admin changes (permalinks, page types, etc)</li>\n</ul>",
        "1.1.3": "<ul>\n<li>Add additional rewrite rules for categories, tags, author</li>\n</ul>",
        "1.1.8": "<ul>\n<li>Rework rewrite rules so that if rewrite rules are ever flushed, we add back the language rewrite rules</li>\n</ul>",
        "1.1.9": "<ul>\n<li>Update bundle to support title on tabs</li>\n</ul>",
        "1.1.12": "<ul>\n<li>Update bundle to translate aria-labels and to parse full html elements</li>\n</ul>",
        "1.1.15": "<ul>\n<li>Remove rewrite rules</li>\n</ul>",
        "1.1.17": "<ul>\n<li>Allow page visibility to be configured</li>\n</ul>",
        "1.1.18": "<ul>\n<li>Update bundle to handle null/undefined values</li>\n</ul>",
        "1.1.21": "<ul>\n<li>Cache bust config</li>\n</ul>"
    },
