    "sections": {
        "description": "<p>FitCalc is a simple BMI calculator supporting Metric (cm, kg) and Imperial (ft/in, lbs) units. Accessible, responsive, translation ready.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to <code>/wp-content/plugins/</code></li>\n<li>Activate the plugin from <em>Plugins</em></li>\n<li>Add the shortcode <code>[fitcalc_bmi]</code> to any page/post.</li>\n</ol>\n",
        "changelog": "<h4>1.0.7</h4>\n<ul>\n<li>Add Metric/Imperial toggle</li>\n<li>Age &amp; Gender fields</li>\n<li>Accessibility improvements</li>\n<li>Cleaner UI &amp; scripts enqueue only on shortcode</li>\n</ul>\n"
    },
    "short_description": "Lightweight BMI calculator with Metric and Imperial units. Use the shortcode [fitcalc_bmi].",
    "description": "<p>FitCalc is a simple BMI calculator supporting Metric (cm, kg) and Imperial (ft/in, lbs) units. Accessible, responsive, translation ready.</p>\n",
