    "sections": {
        "description": "<p>Tired of the struggle with &#8220;Shift+Enter&#8221; on mobile devices or tablets?<br />\nThis plugin allows you to define a custom mark (like &#8220;;;&#8221; or &#8220;、、&#8221;) that will be automatically converted into a line break (<br />) when you save your post.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to the <code>/wp-content/plugins/</code> directory.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; menu in WordPress.</li>\n<li>Go to Settings &gt; Ushiro-Pocke SLB to set your preferred mark.</li>\n</ol>\n",
        "changelog": "<h4>1.0.1</h4>\n<ul>\n<li>Fixed sanitization and metadata for WordPress.org submission.</li>\n</ul>\n"
    },
