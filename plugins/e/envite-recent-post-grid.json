    "blocks": {
        "envite/recent-posts-grid": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "envite/recent-posts-grid",
            "title": "Recent Posts Grid",
            "category": "widgets",
            "icon": "grid-view",
            "description": "Display recent posts, related posts or any public post type as the grid view.",
            "keywords": [
                "posts",
                "grid",
                "recent",
                "related",
                "blog",
                "envite"
            ],
            "textdomain": "envite-recent-post-grid",
            "attributes": {
                "queryType": {
                    "type": "string",
                    "default": "recent"
                },
                "postType": {
                    "type": "string",
                    "default": "post"
                },
                "taxonomy": {
                    "type": "string",
                    "default": "category"
                },
                "termIds": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    },
                    "default": []
                },
                "postIn": {
                    "type": "string",
                    "default": ""
                },
                "excludeCurrent": {
                    "type": "boolean",
                    "default": false
                },
                "postsPerPage": {
                    "type": "integer",
                    "default": 3
                },
                "offset": {
                    "type": "integer",
                    "default": 0
                },
                "orderBy": {
                    "type": "string",
                    "default": "date"
                },
                "order": {
                    "type": "string",
                    "default": "DESC"
                },
                "columns": {
                    "type": "integer",
                    "default": 3
                },
                "gap": {
                    "type": "integer",
                    "default": 15
                },
                "imageRatio": {
                    "type": "string",
                    "default": "auto"
                },
                "displayImage": {
                    "type": "boolean",
                    "default": true
                },
                "imageSize": {
                    "type": "string",
                    "default": "large"
                },
                "linkImage": {
                    "type": "boolean",
                    "default": true
                },
                "displayTitle": {
                    "type": "boolean",
                    "default": true
                },
                "titleTag": {
                    "type": "string",
                    "default": "h3"
                },
                "displayExcerpt": {
                    "type": "boolean",
                    "default": true
                },
                "excerptLength": {
                    "type": "integer",
                    "default": 20
                },
                "displayAuthor": {
                    "type": "boolean",
                    "default": false
                },
                "displayDate": {
                    "type": "boolean",
                    "default": false
                },
                "displayTaxonomy": {
                    "type": "boolean",
                    "default": false
                }
            },
            "supports": {
                "html": false,
                "align": [
                    "wide",
                    "full"
                ],
                "color": {
                    "background": true,
                    "text": true,
                    "link": true
                },
                "spacing": {
                    "margin": true,
                    "padding": true
                },
                "typography": {
                    "fontSize": true,
                    "lineHeight": true
                }
            },
            "styles": [
                {
                    "name": "default",
                    "label": "Shadow",
                    "isDefault": true
                },
                {
                    "name": "bordered",
                    "label": "Bordered"
                },
                {
                    "name": "plain",
                    "label": "Plain"
                }
            ],
            "usesContext": [
                "postId",
                "postType"
            ],
            "editorScript": "envite-rpg-editor",
            "style": "file:./assets/style.css"
        }
    },
