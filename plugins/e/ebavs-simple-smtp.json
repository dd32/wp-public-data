    "sections": {
        "description": "<p>EBAVS Simple SMTP lets you configure WordPress email delivery through SMTP using only the basic required fields: host, user, password and port.</p>\n<p>This plugin is intentionally simple and lightweight.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin files to the <code>/wp-content/plugins/ebavs-simple-smtp/</code> directory.</li>\n<li>Activate the plugin through the WordPress admin.</li>\n<li>Go to Settings &gt; SMTP By EBAVS.</li>\n<li>Enter your SMTP configuration.</li>\n<li>Send a test email.</li>\n</ol>\n",
        "faq": "\n<dt id=\"does%20this%20plugin%20create%20database%20tables%3F\">\nDoes this plugin create database tables?\n</h4>\n<p>\n<p>No. It only stores the SMTP settings using WordPress options.</p>\n</p>\n<dt id=\"does%20this%20plugin%20use%20external%20dependencies%3F\">\nDoes this plugin use external dependencies?\n</h4>\n<p>\n<p>No.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
    "short_description": "A simple SMTP configuration plugin for WordPress.",
    "description": "<p>EBAVS Simple SMTP lets you configure WordPress email delivery through SMTP using only the basic required fields: host, user, password and port.</p>\n<p>This plugin is intentionally simple and lightweight.</p>\n",
