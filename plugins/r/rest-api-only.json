    "sections": {
        "description": "<p>This plugin forces all non-admin, non-AJAX, and non-REST API requests to return a 404 status code.<br />\nIdeal for headless WordPress environments or sites that should expose only the API.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to <code>/wp-content/plugins/</code></li>\n<li>Activate the plugin through the &#8220;Plugins&#8221; menu in WordPress</li>\n</ol>\n",
        "changelog": "<h4>1.0.1</h4>\n<ul>\n<li>Adjusted plugin name capitalization and added a direct access guard.</li>\n</ul>\n<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
    "short_description": "Force all non-admin, non-AJAX, and non-REST API requests to return a 404 for headless or API-only sites.",
