    "sections": {
        "description": "<p><strong>Fill your schedule, grow your business.</strong><br />\nBreely is the most flexible platform allowing you build the exact appointment scheduling, forms, and workflows for your business.</p>\n<p>Breely offers 1:1 appointment scheduling, group classes, workshops, and class series scheduling.<br />\nYou can also create forms, waivers, and more. This plugin allows you to embed the forms<br />\ncreated in Breely into your WordPress site.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin files to the <code>/wp-content/plugins/breely</code> directory, or install the plugin through the WordPress plugins screen directly.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; screen in WordPress</li>\n<li>Add the &#8220;Breely&#8221; block to your site and set the form URL to add</li>\n</ol>\n",
        "faq": "\n<dt id='is%20a%20breely%20account%20required%3F'>\nIs a Breely account required?\n</h4>\n<p>\n<p>Yes, you must sign up on https://www.breely.com/ for an account first in order to create a form to<br />\nto embed.</p>\n</p>\n<dt id='is%20this%20free%3F'>\nIs this free?\n</h4>\n<p>\n<p>Yes, this works with free Breely plans.</p>\n</p>\n\n",
        "changelog": "<h4>0.1.0</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
