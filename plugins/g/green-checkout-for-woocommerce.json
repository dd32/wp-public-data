    "sections": {
        "description": "<p>Green Checkout lets customers optionally add a small carbon offset contribution at WooCommerce checkout.</p>\n<ul>\n<li>Choose amount and label from settings.</li>\n<li>Adds fee instantly to order total.</li>\n<li>Stores choice in order meta for reporting.</li>\n</ul>\n",
        "installation": "<ol>\n<li>Upload the plugin files to <code>/wp-content/plugins/green-checkout</code>.</li>\n<li>Activate the plugin through the <strong>Plugins</strong> screen in WordPress.</li>\n<li>Go to <strong>Green Checkout <span aria-hidden=\"true\" class=\"wp-exclude-emoji\">→</span> Settings</strong> to configure amount and label.</li>\n</ol>\n",
        "faq": "\n<dt id='can%20i%20change%20the%20amount%3F'>\nCan I change the amount?\n</h4>\n<p>\n<p>Yes, in the settings page.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
