    "sections": {
        "description": "<p>Adds a ZIP file format to download translations from <a href=\"https://wordpress.org/plugins/glotpress/\" rel=\"ugc\">GlotPress</a>.<br />\nThis format is a ZIP archive containing the PO, MO &amp; PHP translation files for the selected language.</p>\n<h4>Configuration</h4>\n<p>Once you have installed GP Format ZIP it is ready to use.<br />\nIt requires the PHP ZIP extension to be installed and enabled on your server.</p>\n",
        "changelog": "<h4>1.1</h4>\n<ul>\n<li>Added PHP language file to the ZIP archive.</li>\n</ul>\n<h4>1.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
    "short_description": "Adds a ZIP file format to download translations from GlotPress.",
