    "sections": {
        "description": "<p>This plugin adds &#8220;Share with AI&#8221; buttons above the featured image in single blog posts, allowing users to send the post link directly to ChatGPT, Google Gemini, Perplexity AI, and Claude.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin files to the <code>/wp-content/plugins/share-with-ai</code> directory, or install it through the WordPress plugins screen directly.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; screen in WordPress</li>\n<li>You&#8217;re done! Buttons will appear automatically on single post pages.</li>\n</ol>\n",
        "changelog": "<h4>1.0</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
    "short_description": "Add share buttons to post pages so users can send links to AI tools like ChatGPT, Gemini, and others.",
