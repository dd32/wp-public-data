    "sections": {
        "description": "<p>SmartUpWorld Feed Control helps WordPress admins easily disable RSS feeds and author archives for SEO and privacy reasons. Includes settings and status pages.</p>\n",
        "installation": "<ol>\n<li>Upload the <code>smartupworld-feed-control</code> folder to the <code>/wp-content/plugins/</code> directory.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; menu in WordPress.</li>\n<li>Configure options under &#8216;Settings <span aria-hidden=\"true\" class=\"wp-exclude-emoji\">→</span> Feed Control&#8217;.</li>\n</ol>\n",
        "changelog": "<h4>1.2</h4>\n<ul>\n<li>Added admin panel footer credit link</li>\n<li>Improved feed control options</li>\n</ul>\n"
    },
