    "sections": {
        "description": "<p>This lightweight plugin lets you replace the default WooCommerce Add to Cart text from the WordPress dashboard.</p>\n<p>Features:</p>\n<ul>\n<li>Global text replacement</li>\n<li>Simple settings page</li>\n<li>Lightweight</li>\n<li>Secure input handling</li>\n<li>Clean uninstall</li>\n</ul>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to /wp-content/plugins/</li>\n<li>Activate the plugin</li>\n<li>Go to Settings <span aria-hidden=\"true\" class=\"wp-exclude-emoji\">→</span> Cart Button Customizer</li>\n<li>Enter custom text and save</li>\n</ol>\n",
        "changelog": "<h4>1.0</h4>\n<p>Initial release.</p>\n"
    },
    "short_description": "SmallEasy Cart Button Customizer allows you to change the WooCommerce Add to Cart button text globally.",
