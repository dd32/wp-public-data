    "sections": {
        "description": "<p>Safelayout Animated Header Footer, helps you add a beautiful animation to the background of your website header and footer.</p>\n",
        "installation": "<ul>\n<li>Go to the Plugins section of your WordPress dashboard.</li>\n<li>Click on Add New.</li>\n<li>Click on the Upload Plugin button.</li>\n<li>Browse and locate the zipped plugin that you have downloaded.</li>\n<li>Activate the plugin by clicking on Activate.</li>\n<li>Use the Settings -&gt; <strong>Safelayout Header Footer</strong> to configure the plugin.</li>\n<li>Choose your animation and enjoy.</li>\n</ul>\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial Release.</li>\n</ul>\n"
    },
