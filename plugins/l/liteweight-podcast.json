    "blocks": {
        "pdp/podcast": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 2,
            "name": "pdp/podcast",
            "title": "Audio Podcast",
            "category": "media",
            "icon": "video-alt2",
            "description": "A customizable audio player with podcast support.",
            "keywords": [
                "audio",
                "player",
                "podcast"
            ],
            "version": "1.0.0",
            "textdomain": "pdp",
            "attributes": {
                "podcasts": {
                    "type": "array",
                    "default": [
                        {
                            "title": "title",
                            "audio": "",
                            "image": ""
                        }
                    ]
                },
                "controls": {
                    "type": "object",
                    "default": {
                        "play": true,
                        "progress": true,
                        "current-time": true,
                        "mute": true,
                        "volume": true,
                        "settings": true,
                        "download": true
                    }
                },
                "playerType": {
                    "type": "string",
                    "default": "Default"
                },
                "theme": {
                    "type": "string",
                    "default": "light"
                },
                "featureImage": {
                    "type": "boolean",
                    "default": true
                },
                "loop": {
                    "type": "boolean",
                    "default": false
                },
                "share": {
                    "type": "boolean",
                    "default": true
                },
                "showLabel": {
                    "type": "boolean",
                    "default": false
                },
                "showCount": {
                    "type": "boolean",
                    "default": false
                },
                "shares": {
                    "type": "array",
                    "default": [
                        "facebook",
                        "twitter",
                        "linkedin",
                        "pinterest",
                        "stumbleupon",
                        "whatsapp",
                        "email"
