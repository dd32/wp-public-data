    "sections": {
        "description": "<p>Reviews Carousel is an absolutely free plugin that allows you to create a custom post type for reviews. You can manually add reviews and display them in a carousel format anywhere on your site using the shortcode:</p>\n<pre><code>[revica]\n</code></pre>\n",
        "installation": "<ol>\n<li>Go to <strong>Plugins &gt; Add New</strong> in your WordPress dashboard.</li>\n<li>Type <strong>Reviews Carousel</strong> in the search box.</li>\n<li>Click <strong>Install Now</strong> to install the plugin.</li>\n<li>After installation, click <strong>Activate</strong> to start using the <strong>Reviews Carousel</strong>.</li>\n<li>Go to <strong>Reviews</strong> from the Dashboard menu.</li>\n<li>Add your review data.</li>\n<li>Use the shortcode <code>[revica]</code> to display the review carousel anywhere on your site.</li>\n</ol>\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial Release</li>\n</ul>\n"
    },
