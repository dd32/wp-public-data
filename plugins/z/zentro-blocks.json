                "animated"
            ],
            "textdomain": "zentro-blocks",
            "attributes": {
                "targetNumber": {
                    "type": "number",
                    "default": 1000
                },
                "prefix": {
                    "type": "string",
                    "default": ""
                },
                "suffix": {
                    "type": "string",
                    "default": "+"
                },
                "label": {
                    "type": "string",
                    "default": "Happy Clients"
                },
                "duration": {
                    "type": "number",
                    "default": 2000
                },
                "numberColor": {
                    "type": "string",
                    "default": "#0073aa"
                },
                "labelColor": {
                    "type": "string",
                    "default": "#333333"
                },
                "numberSize": {
                    "type": "number",
                    "default": 48
                },
                "labelSize": {
                    "type": "number",
                    "default": 16
                },
                "alignment": {
                    "type": "string",
                    "default": "center"
                },
                "separator": {
                    "type": "boolean",
                    "default": false
                }
            },
            "supports": {
                "html": false,
                "align": [
                    "wide",
                    "full"
                ]
            },
            "render": "file:./render.php",
            "editorScript": "file:./index.js",
            "editorStyle": "file:./index.css",
            "style": "file:./style-index.css",
            "viewScript": "file:./view.js"
