    "sections": {
        "description": "<p>This plugin connects a WordPress site to the Obsera platform and loads a live widget for customer communication.</p>\n<p>It integrates with an external service provided by Obsera.</p>\n<p>External services used:<br />\n&#8211; https://dashboard.obsera.com<br />\n&#8211; https://cdn.obsera.com/loader.js</p>\n<p>Service:<br />\nhttps://obsera.com</p>\n<p>Terms:<br />\nhttps://dashboard.obsera.com/terms-of-service</p>\n<p>Privacy:<br />\nhttps://obsera.com/privacy-policy</p>\n",
        "installation": "<ol>\n<li>Upload plugin</li>\n<li>Activate</li>\n<li>Go to Obsera Widget menu</li>\n<li>Connect account</li>\n</ol>\n",
        "faq": "\n<dt id=\"does%20it%20require%20an%20account%3F\">\nDoes it require an account?\n</h4>\n<p>\n<p>Yes.</p>\n</p>\n<dt id=\"does%20it%20load%20external%20scripts%3F\">\nDoes it load external scripts?\n</h4>\n<p>\n<p>Yes, from Obsera CDN.</p>\n</p>\n\n",
