    "sections": {
        "description": "<p>Oba Comp Widget is a lightweight WooCommerce product comparator. Allow your customers to compare products in one click with a modern and brilliant interface.</p>\n",
        "installation": "<ol>\n<li>Download the plugin zip file.</li>\n<li>Go to Plugins &gt; Add New &gt; Upload Plugin.</li>\n<li>Install and Activate.</li>\n<li>Configure your colors in Settings &gt; Quick Compare.</li>\n</ol>\n",
        "faq": "\n<dt id=\"how%20to%20change%20the%20badge%20color%3F\">\nHow to change the badge color?\n</h4>\n<p>\n<p>Go to Settings &gt; Quick Compare and use the color picker.</p>\n</p>\n\n"
    },
    "short_description": "Oba Comp Widget is A lightweight tool to compare WooCommerce products , manage variations and boost your conversion rate.",
    "description": "<p>Oba Comp Widget is a lightweight WooCommerce product comparator. Allow your customers to compare products in one click with a modern and brilliant interface.</p>\n",
