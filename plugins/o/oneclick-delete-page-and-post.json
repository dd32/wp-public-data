    "sections": {
        "description": "<p>One Click Delete Page and Post is a lightweight, secure WordPress plugin that adds a Delete item to the frontend admin bar next to the Edit link. When clicked, it asks for confirmation and — if the current user has the delete_post capability — moves the current page or post to the Trash.</p>\n",
        "installation": "<ol>\n<li>Upload the oneclick-delete-page-and-post folder to the /wp-content/plugins/ directory.</li>\n<li>Activate the plugin through the &#8220;Plugins&#8221; menu in WordPress.</li>\n</ol>\n",
        "changelog": "<h4>1.0.0 (2025-08-26)</h4>\n"
    },
    "short_description": "Adds a &quot;Delete&quot; dropdown item to the frontend admin bar &quot;Edit&quot; menu.",
