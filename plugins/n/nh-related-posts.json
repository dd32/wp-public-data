    "sections": {
        "description": "<p>Post Relation displays related posts automatically at the end of single posts based on categories. Lightweight and responsive.</p>\n",
        "installation": "<ol>\n<li>Upload the &#8216;post-relation&#8217; folder to the &#8216;/wp-content/plugins/&#8217; directory.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; menu in WordPress.</li>\n<li>Related posts will automatically appear on single posts.</li>\n</ol>\n",
        "faq": "\n<dt id='can%20i%20change%20the%20number%20of%20related%20posts%3F'>\nCan I change the number of related posts?\n</h4>\n<p>\n<p>Yes, you can edit &#8216;posts_per_page&#8217; in &#8216;includes/post.php&#8217;.</p>\n</p>\n<dt id='can%20i%20change%20the%20layout%3F'>\nCan I change the layout?\n</h4>\n<p>\n<p>Yes, edit the CSS in style.css.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.3</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
