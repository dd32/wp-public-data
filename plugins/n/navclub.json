    "sections": {
        "description": "<p>NavClub integrates with WooCommerce to manage membership plans, member quotas, requests, automated renewal reminders, and customer account features. It provides an administrative interface for managing plans and members while integrating seamlessly with the WooCommerce My Account area.</p>\n",
        "installation": "<ol>\n<li>Install and activate WooCommerce.</li>\n<li>Upload the NavClub plugin to /wp-content/plugins/</li>\n<li>Activate NavClub.</li>\n<li>Configure membership plans under NavClub.</li>\n</ol>\n",
        "faq": "\n<dt id=\"does%20it%20create%20custom%20database%20tables%3F\">\nDoes it create custom database tables?\n</h4>\n<p>\n<p>No. NavClub uses the standard WordPress options, user meta, and post meta tables. It does not create any custom database tables.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
