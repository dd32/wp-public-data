    "blocks": {
        "kurage-worker/md-table-editor": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "kurage-worker/md-table-editor",
            "version": "0.1.0",
            "title": "MdTableEditor with Block Editor",
            "category": "text",
            "icon": "smile",
            "description": "This is an editor that allows you to edit tables in Markdown notation.",
            "example": [],
            "supports": {
                "html": false,
                "align": true,
                "alignWide": true
            },
            "attributes": {
                "markdown": {
                    "type": "string",
                    "default": ""
                },
                "viewMode": {
                    "enum": [
                        "code",
                        "view",
                        "both"
                    ],
                    "default": "both"
                },
                "splitSize": {
                    "type": "number",
                    "default": 50
                },
                "editHeight": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "default": null
                }
            },
            "textdomain": "mdtableeditor",
            "editorScript": "file:./index.js",
            "editorStyle": "file:./index.css",
            "style": "file:./style-index.css",
            "viewScript": "file:./view.js"
        }
    },
