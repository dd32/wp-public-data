    "sections": {
        "description": "<p>This ACF field type is compatible with:<br />\n* ACF 5.7+</p>\n",
        "installation": "<ol>\n<li>Download &#8220;Support For Icomoon with Advanced Custom Fields&#8221; plugin</li>\n<li>Upload it to your wp-content/plugins directory</li>\n<li>Go to CMS admin plugins list and activate the plugin</li>\n<li>Go to Field Groups &gt; Create new Field and choose Icomoon Type in Content Group.</li>\n</ol>\n",
        "changelog": "<h4>4.0.16</h4>\n<p><em>Release Date &#8211; 20 August 2025</em></p>\n<ul>\n<li>Fixed: _load_textdomain_just_in_time was called incorrectly from WordPress 6.8.1</li>\n<li>Fixed: Remove PHP deprecated notices for PHP 8.3.</li>\n</ul>\n"
    },
    "short_description": "Add a field to select icons from a selection.json file generated by IcoMoon",
