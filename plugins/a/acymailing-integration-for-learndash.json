    "sections": {
        "description": "<blockquote>\n<h4>Requirements</h4>\n<p><a href=\"https://wordpress.org/plugins/acymailing/\" rel=\"ugc\">AcyMailing</a><br />\n  <a href=\"https://www.learndash.com/\" rel=\"nofollow ugc\">Learndash</a></p>\n</blockquote>\n<p>Features :</p>\n<ul>\n<li>Filter your users on their Learndash groups</li>\n<li>Filter your users on attended courses</li>\n</ul>\n",
        "installation": "<ol>\n<li>In your Admin click on your Plugin then &#8220;Add New&#8221;</li>\n<li>Search for <code>Learndash AcyMailing</code></li>\n<li>Find it, install it, enable it</li>\n<li>You&#8217;re done!</li>\n</ol>\n",
        "faq": "\n<dt id=\"how%20to%20contact%20us%3F\">\nHow to contact us?\n</h4>\n<p>\n<p>Feel free to do it via this form: https://www.acymailing.com/contact/</p>\n</p>\n<dt id=\"where%20can%20i%20find%20a%20documentation%3F\">\nWhere can I find a documentation?\n</h4>\n<p>\n<p>You can find the complete documentation here: https://docs.acymailing.com/addons/wordpress-add-ons/learndash</p>\n</p>\n\n",
        "changelog": "<h4>1.0 &#8211; January 22nd, 2025</h4>\n<ul>\n<li>Initial version</li>\n<li>Filter your users on their Learndash groups</li>\n<li>Filter your users on attended courses</li>\n</ul>\n<p><a href=\"https://www.acymailing.com/changelog\" rel=\"nofollow ugc\">See the whole changelog here.</a></p>\n"
    },
