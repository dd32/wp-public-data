    "sections": {
        "description": "<p>Ansar Themekit is a high-performance, lightweight companion plugin designed specifically for Ansar themes. It provides optimized Gutenberg blocks like the List Card block that integrate seamlessly with the WordPress Query Loop.</p>\n",
        "installation": "<ol>\n<li>Upload <code>ansar-themekit</code> to the <code>/wp-content/plugins/</code> directory.</li>\n<li>Activate the plugin through the &#8216;Plugins&#8217; menu in WordPress.</li>\n<li>Use the Ansar List Card block inside the WordPress Query Loop.</li>\n</ol>\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
    "short_description": "Lightweight, performance-optimized companion plugin for Ansar themes featuring custom query loop blocks.",
    "description": "<p>Ansar Themekit is a high-performance, lightweight companion plugin designed specifically for Ansar themes. It provides optimized Gutenberg blocks like the List Card block that integrate seamlessly with the WordPress Query Loop.</p>\n",
