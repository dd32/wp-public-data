    "blocks": {
        "ansar-themekit/post-card": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "ansar-themekit/post-card",
            "title": "Posts Grid",
            "category": "theme",
            "icon": "index-card",
            "description": "Displays posts from a selected category in a grid.",
            "attributes": {
                "title": {
                    "type": "string",
                    "default": "Posts Grid"
                },
                "postsToShow": {
                    "type": "number",
                    "default": 10
                },
                "category": {
                    "type": "number",
                    "default": 0
                },
                "cardLayout": {
                    "type": "string",
                    "default": "grid"
                },
                "columns": {
                    "type": "number",
                    "default": 2
                }
            },
            "supports": {
                "html": false
            },
            "editorScript": "file:../../../build/blocks/post-card/index.js",
            "style": "file:../../../build/blocks/post-card/style-index.css"
        },
        "ansar-themekit/featured-posts": {
            "$schema": "https://schemas.wp.org/trunk/block.json",
            "apiVersion": 3,
            "name": "ansar-themekit/featured-posts",
            "title": "AnsarThemekit Featured Posts",
            "category": "widgets",
            "icon": "star-filled",
            "description": "Display a featured post with three supporting posts.",
            "attributes": {
                "title": {
                    "type": "string",
                    "default": "AnsarThemekit Featured Posts"
                },
                "category": {
                    "type": "number",
                    "default": 0
                },
