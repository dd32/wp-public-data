    "sections": {
        "description": "<p>Anise Simple Discounts allows store administrators to assign a permanent percentage discount to individual WooCommerce customers directly from the user profile page.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin to the <code>/wp-content/plugins/</code> directory.</li>\n<li>Activate the plugin.</li>\n<li>Edit a user profile and set the discount percentage.</li>\n</ol>\n",
        "faq": "\n<dt id=\"does%20this%20plugin%20require%20woocommerce%3F\">\nDoes this plugin require WooCommerce?\n</h4>\n<p>\n<p>Yes. WooCommerce must be installed and activated.</p>\n</p>\n<dt id=\"how%20do%20i%20assign%20a%20discount%3F\">\nHow do I assign a discount?\n</h4>\n<p>\n<p>Edit a user&#8217;s profile and enter a value between 1 and 99.</p>\n</p>\n\n",
        "changelog": "<h4>1.0.0</h4>\n<p>Initial release.</p>\n"
    },
