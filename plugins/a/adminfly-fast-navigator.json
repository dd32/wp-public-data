    "sections": {
        "description": "<p>Adds a convenient &#8220;AdminFly&#8221; item to the WordPress admin bar for quick access to import/export functionality.</p>\n<ul>\n<li>WooCommerce Product Import/Export (when WooCommerce is active)</li>\n<li>WordPress Import/Export (fallback when WooCommerce is not active)</li>\n<li>Only visible to users with appropriate permissions</li>\n</ul>\n",
        "installation": "<ol>\n<li>Upload to <code>/wp-content/plugins/</code> directory</li>\n<li>Activate through the &#8216;Plugins&#8217; menu</li>\n<li>AdminFly appears in admin bar automatically</li>\n</ol>\n",
        "changelog": "<h4>1.0.0</h4>\n<ul>\n<li>Initial release</li>\n</ul>\n"
    },
    "short_description": "Adds an &quot;AdminFly&quot; to the admin bar with quick access to WooCommerce Import/Export tools.",
