    "sections": {
        "description": "<p>A cryptocurrency payment gateway with blocks support for WooCommerce block-based checkout.<br />\nAllows users to pay from cryptocurrency exchanges (<strong>Coinbase</strong>, <strong>Binance</strong>, &#8230;), or directly using <strong>WalletConnect</strong>.</p>\n",
        "installation": "<ol>\n<li>Contact Blockmate.io at info@blockmate.io to obtain your merchant credentials</li>\n<li>Install the plugin</li>\n<li>Activate the plugin through the &#8220;Plugins&#8221; menu in WordPress.</li>\n<li>Fill all requested data under WP Admin &gt; Settings &gt; Blockmate.io</li>\n<li>Enable the gateway under WP Admin &gt; WooCommerce &gt; Payments</li>\n</ol>\n",
        "faq": "\n<dt id='what%20currencies%20are%20supported%3F'>\nWhat currencies are supported?\n</h4>\n<p>\n<p>The current version supports <strong>BTC</strong>, <strong>ETH</strong> and <strong>USDC</strong>.</p>\n</p>\n\n",
        "changelog": "<h4>v1.0.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
    },
    "short_description": "Cryptocurrency payments plugin for WooCommerce by Blockmate.io",
