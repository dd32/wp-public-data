                    }
                },
                "containerBoxShadow": {
                    "type": "string",
                    "groupSelector": {
                        "type": "BlockishBoxShadow",
                        "selector": ".{{WRAPPER}}"
                    }
                },
                "containerHoverBoxShadow": {
                    "type": "string",
                    "groupSelector": {
                        "type": "BlockishBoxShadow",
                        "selector": ".{{WRAPPER}}:hover"
                    }
                }
            },
            "supports": {
