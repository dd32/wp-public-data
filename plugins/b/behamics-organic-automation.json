    "sections": {
        "description": "<p>This plugin provides secure REST API endpoints to create or update WordPress pages via API with support for Elementor and ACF.</p>\n",
        "installation": "<ol>\n<li>Upload the plugin folder to <code>/wp-content/plugins/</code></li>\n<li>Activate it from the WordPress admin panel.</li>\n<li>Copy the API token from the &#8220;Behamics Automation&#8221; admin menu.</li>\n<li>Use this token for secure API calls.</li>\n</ol>\n",
        "faq": "\n<dt id='how%20do%20i%20get%20my%20api%20token%3F'>\nHow do I get my API token?\n</h4>\n<p>\n<p>After activation, go to &#8220;Behamics Automation&#8221; in the sidebar and copy your unique API token.</p>\n</p>\n\n",
        "changelog": "<h4>1.0</h4>\n<ul>\n<li>Initial release.</li>\n</ul>\n"
