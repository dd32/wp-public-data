                    "type": "boolean",
                    "default": true
                },
                "className": {
                    "type": "string",
                    "default": ""
                },
                "textColor": {
                    "type": "string",
                    "default": ""
                },
                "backgroundColor": {
                    "type": "string",
                    "default": ""
                },
                "align": {
                    "type": "string",
                    "default": ""
                },
                "typography": {
                    "type": "string",
                    "default": ""
                },
                "fontSize": {
                    "type": "string",
                    "default": ""
                },
                "style": {
                    "type": "object",
                    "default": []
                }
            },
            "usesContext": [
                "postId"
            ],
            "selectors": {
                "root": ".wp-block-bcn-breadcrumb-trail"
            },
            "supports": {
                "align": true,
                "color": {
                    "text": true,
                    "link": true,
                    "background": true,
                    "gradients": true,
                    "enableContrastChecker": true
                },
                "background": {
                    "backgroundImage": true
                },
                "typography": {
                    "fontSize": true,
                    "fontWeight": true,
                    "fontStyle": true,
                    "textAlign": true,
                    "lineHeight": true
                },
                "html": false
            },
            "example": {
                "attributes": {
                    "pretext": "You are here:"
                }
            },
            "editorScript": "file:./index.js",
            "render": "file:./render.php"
        }
