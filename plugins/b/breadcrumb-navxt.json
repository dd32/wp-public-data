                    "default": ""
                },
                "format": {
                    "type": "string",
                    "enum": [
                        "list",
                        "breadcrumblist_rdfa",
                        "breadcrumblist_rdfa_wai_aria",
                        "breadcrumblist_microdata",
                        "plain"
